# =============================================================================
# Python image for the API and the Celery workers.
#
# Both services share one Dockerfile and one dependency layer so the expensive
# parts - Tesseract, LibreOffice, the wheel set - are built and cached exactly
# once. The targets differ only in what they add on top and how they start:
#
#   --target api     FastAPI behind Gunicorn.
#   --target worker  Celery. Tesseract (eng, urd, osd) is already in the base
#                    layer, so OCR works with no outbound network at all.
# =============================================================================

# -----------------------------------------------------------------------------
FROM python:3.11-slim-bookworm AS base
# -----------------------------------------------------------------------------
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive \
    TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata

# Runtime system packages:
#   tesseract-ocr(+eng,+urd)  primary OCR engine and its language data
#   libreoffice-writer        headless legacy .doc -> .docx conversion
#   libmagic1                 content-based MIME sniffing (python-magic)
#   libglib2.0-0, libgl1      shared libraries OpenCV's wheels load at import.
#   fonts-noto-core           glyph coverage for rasterised pages, including
#                             NotoNastaliqUrdu for Urdu text in the review pane
#                             (there is no separate fonts-noto-nastaliq-urdu
#                             package on bookworm - it lives in -core)
RUN apt-get update && apt-get install -y --no-install-recommends \
        tesseract-ocr \
        tesseract-ocr-eng \
        tesseract-ocr-urd \
        tesseract-ocr-osd \
        libtesseract5 \
        libreoffice-writer \
        libreoffice-core \
        libmagic1 \
        libglib2.0-0 \
        libgl1 \
        libgomp1 \
        fonts-dejavu-core \
        fonts-liberation2 \
        fonts-noto-core \
        curl \
        tini \
    && rm -rf /var/lib/apt/lists/*

# Fail the build rather than ship an image whose OCR silently cannot run.
RUN tesseract --version \
    && tesseract --list-langs 2>&1 | grep -qx eng \
    && tesseract --list-langs 2>&1 | grep -qx urd \
    && tesseract --list-langs 2>&1 | grep -qx osd \
    && soffice --version

RUN groupadd --gid 10001 certex \
    && useradd --uid 10001 --gid certex --create-home --shell /usr/sbin/nologin certex

WORKDIR /app

# -----------------------------------------------------------------------------
FROM base AS python-deps
# -----------------------------------------------------------------------------
# Only the manifest is copied first, so editing source code does not invalidate
# the dependency layer.
COPY api/pyproject.toml /app/api/pyproject.toml
COPY api/certex/__init__.py /app/api/certex/__init__.py

RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install -e /app/api

# -----------------------------------------------------------------------------
FROM python-deps AS api
# -----------------------------------------------------------------------------
# Build with --build-arg INSTALL_DEV=true to include pytest, mypy, ruff and the
# fixture generators, so the suite can run inside the image it will ship as.
# Production builds leave it false and carry none of that.
ARG INSTALL_DEV=false
RUN if [ "$INSTALL_DEV" = "true" ]; then python -m pip install -e "/app/api[dev]"; fi

COPY api /app/api
COPY infra/alembic.ini /app/infra/alembic.ini
COPY infra/alembic /app/infra/alembic
# The migrate service runs from this same image, so both entrypoints ship here.
COPY infra/docker/entrypoint-api.sh /usr/local/bin/entrypoint-api.sh
COPY infra/docker/entrypoint-migrate.sh /usr/local/bin/entrypoint-migrate.sh
RUN chmod +x /usr/local/bin/entrypoint-api.sh /usr/local/bin/entrypoint-migrate.sh \
    && python -m pip install --no-deps -e /app/api \
    && chown -R certex:certex /app

USER certex
EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
    # 127.0.0.1 rather than localhost: the container resolves the name to ::1,
# and the server binds IPv4.
    CMD curl -fsS http://127.0.0.1:8000/health/live || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint-api.sh"]

# -----------------------------------------------------------------------------
FROM python-deps AS worker
# -----------------------------------------------------------------------------
ARG INSTALL_DEV=false
RUN if [ "$INSTALL_DEV" = "true" ]; then python -m pip install -e "/app/api[dev]"; fi

COPY api /app/api
COPY worker /app/worker
COPY infra/alembic.ini /app/infra/alembic.ini
COPY infra/alembic /app/infra/alembic
COPY infra/docker/entrypoint-worker.sh /usr/local/bin/entrypoint-worker.sh
COPY infra/docker/healthcheck-worker.sh /usr/local/bin/healthcheck-worker.sh
RUN chmod +x /usr/local/bin/entrypoint-worker.sh /usr/local/bin/healthcheck-worker.sh \
    && python -m pip install --no-deps -e /app/api \
    && python -m pip install --no-deps -e /app/worker \
    && chown -R certex:certex /app

USER certex

# Health depends on WORKER_ROLE: a worker answers a ping addressed to its own
# node name, while beat proves it can still publish to the broker.
HEALTHCHECK --interval=30s --timeout=15s --start-period=90s --retries=5 \
    CMD /usr/local/bin/healthcheck-worker.sh || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint-worker.sh"]
