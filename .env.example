# =============================================================================
# CertExtract - environment configuration
# Copy to `.env` and adjust. Every variable the stack reads is listed here.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# One of: local | staging | production. Controls docs exposure + cookie defaults.
APP_ENV=local
# Human-readable name shown in the UI header and CSV export metadata.
APP_NAME=CertExtract
# DEBUG | INFO | WARNING | ERROR. Field VALUES are redacted at every level by the
# logging filter, so raising this never leaks PII - it only raises volume.
LOG_LEVEL=INFO
# json | console. `console` is human-readable for local dev.
LOG_FORMAT=console
# Comma-separated browser origins allowed to call the API with credentials.
# Must match where the BROWSER reaches the frontend. If you change WEB_PORT,
# change this too (Compose defaults it from WEB_PORT when it is left unset).
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Security / auth
# -----------------------------------------------------------------------------
# REQUIRED. Signing key for JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# The app refuses to boot when APP_ENV=production and this is left at the default.
SECRET_KEY=dev-only-insecure-change-me-0000000000000000000000000000000000
# JWT signing algorithm.
JWT_ALGORITHM=HS256
# Access token lifetime (seconds). Short-lived by design.
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime (seconds). Rotated on every use; replay of a consumed
# token is detected and revokes the entire token family.
REFRESH_TOKEN_TTL_SECONDS=1209600
# Send cookies only over HTTPS. MUST be true in production.
COOKIE_SECURE=false
# lax | strict | none. Using `none` requires COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
# Cookie domain. Empty means a host-only cookie.
COOKIE_DOMAIN=
# bcrypt work factor for password hashing.
PASSWORD_BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16)
# -----------------------------------------------------------------------------
POSTGRES_USER=certex
POSTGRES_PASSWORD=certex
POSTGRES_DB=certex
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Async URL used by FastAPI (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://certex:certex@postgres:5432/certex
# Sync URL used by Celery workers and Alembic (psycopg driver).
DATABASE_URL_SYNC=postgresql+psycopg://certex:certex@postgres:5432/certex
# SQLAlchemy connection pool sizing.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
# Log every SQL statement. Debugging only - very noisy.
DB_ECHO=false

# -----------------------------------------------------------------------------
# Redis / Celery
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# Worker concurrency for the general-purpose queues.
CELERY_WORKER_CONCURRENCY=4
# Dedicated concurrency for the CPU-bound OCR queue. Keep at or below the number
# of physical cores so OCR cannot starve the fast queues.
CELERY_OCR_CONCURRENCY=2
# Hard per-task ceiling (seconds). The task is killed and its document marked
# FAILED with a reason; the rest of the batch continues.
CELERY_TASK_TIME_LIMIT=1800
# Soft limit (seconds) - raises SoftTimeLimitExceeded so a task can checkpoint.
CELERY_TASK_SOFT_TIME_LIMIT=1500
# Retry attempts per task before the payload is routed to the dead-letter queue.
CELERY_TASK_MAX_RETRIES=3
# Base seconds for exponential backoff between retries.
CELERY_RETRY_BACKOFF_SECONDS=5
# Tasks a worker process handles before it is recycled (bounds memory growth).
CELERY_MAX_TASKS_PER_CHILD=50

# -----------------------------------------------------------------------------
# Object storage - MinIO locally. Point S3_ENDPOINT_URL at AWS (or clear it) to
# use real S3; no code changes required.
# -----------------------------------------------------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=certex-documents
S3_REGION=us-east-1
# Path-style addressing is required by MinIO; AWS S3 accepts either.
S3_USE_PATH_STYLE=true
# Server-side encryption at rest. One of: none | AES256 | aws:kms
S3_SSE=AES256
# KMS key id. Only read when S3_SSE=aws:kms
S3_SSE_KMS_KEY_ID=
# Presigned URL lifetime (seconds) for page-image requests from the review pane.
S3_PRESIGN_TTL_SECONDS=900
# MinIO container bootstrap credentials (local dev only).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# MinIO rejects SSE-S3 writes unless a KMS is configured. This built-in dev key
# makes S3_SSE=AES256 work locally. Format is <key-name>:<base64 of 32 bytes>.
# Replace for any deployment holding real records; prefer KES or AWS KMS.
MINIO_KMS_SECRET_KEY=certex-dev-key:Y2VydGV4LWRldi1vbmx5LWttcy1rZXktMzJieXRlcyE=

# -----------------------------------------------------------------------------
# Upload limits
# -----------------------------------------------------------------------------
# Max bytes for a single uploaded file (500 MB).
MAX_FILE_BYTES=524288000
# Max files accepted in one batch.
MAX_BATCH_FILES=2000
# Max total bytes for one batch (5 GB).
MAX_BATCH_BYTES=5368709120
# Chunk size for resumable uploads (8 MB).
UPLOAD_CHUNK_BYTES=8388608
# Hours an unfinished resumable upload stays resumable before its parts are
# discarded.
UPLOAD_SESSION_TTL_HOURS=48
# Nested-archive recursion limit.
MAX_ZIP_DEPTH=2
# Zip-bomb guard: reject when uncompressed/compressed exceeds this ratio.
MAX_ZIP_RATIO=120
# Zip-bomb guard: reject when total uncompressed size exceeds this (2 GB).
MAX_ZIP_UNCOMPRESSED_BYTES=2147483648

# -----------------------------------------------------------------------------
# Text extraction / OCR
# -----------------------------------------------------------------------------
# Tesseract language packs to load, joined with a plus sign. Each must be
# installed in the image. Overridable per batch from the upload screen.
OCR_LANGUAGES=eng+urd
# Rasterization DPI for the first OCR attempt.
OCR_DPI=300
# Higher DPI used on retry for small or dense text.
OCR_HIGH_DPI=600
# Mean word confidence (0-100) below which Tesseract retries the page at
# OCR_HIGH_DPI with alternative preprocessing, keeping the better result.
OCR_FALLBACK_CONFIDENCE=60
# A page is marked NEEDS_OCR when its native text layer yields fewer usable chars.
TEXT_QUALITY_MIN_CHARS=100
# A page is marked NEEDS_OCR when its dictionary hit rate falls below this.
TEXT_QUALITY_MIN_DICT_RATIO=0.35
# Upscale factor applied to low-resolution scans before OCR.
OCR_UPSCALE_FACTOR=2.0
# Rasterized width in pixels under which a page counts as low-resolution.
OCR_UPSCALE_WIDTH_THRESHOLD=1200
# Deadline for one Tesseract run, in seconds. Enforced in code, because Celery's
# task time limits are not available on every platform the worker runs on.
OCR_TIMEOUT_SECONDS=120
# Reuse OCR results for a page image already read with the same settings. Turn off
# only to measure cold OCR throughput.
OCR_CACHE_ENABLED=true
# Absolute path to the tesseract binary. Empty resolves it from PATH.
TESSERACT_CMD=
# Directory holding eng/urd/osd *.traineddata. Empty uses Tesseract's own
# default, which is correct inside the container image.
TESSDATA_PREFIX=
# LibreOffice binary used for legacy .doc conversion.
SOFFICE_CMD=soffice
# Use python-magic (libmagic) for content sniffing. Leave blank to auto-detect:
# enabled on Linux, skipped on Windows where importing it without the native
# library hangs the process. A built-in signature sniffer covers the fallback.
USE_LIBMAGIC=

# -----------------------------------------------------------------------------
# Confidence thresholds and review routing (overridable per workspace)
# -----------------------------------------------------------------------------
# Row confidence at or above which a row is AUTO_APPROVED - also needs zero flags.
CONFIDENCE_AUTO_APPROVE=1.00
# Row confidence below which a row is routed to FAILED instead of NEEDS_REVIEW.
CONFIDENCE_REVIEW_FLOOR=0.60

# -----------------------------------------------------------------------------
# Retention and privacy
# -----------------------------------------------------------------------------
# Documents, page text and extractions are purged - blobs included - after N days.
RETENTION_DAYS=90
# Hour of day (UTC) at which the retention sweep runs.
RETENTION_SWEEP_HOUR=3
# Enable the periodic retention sweep at all.
RETENTION_ENABLED=true

# -----------------------------------------------------------------------------
# LLM fallback (OFF by default, and deliberately so)
# -----------------------------------------------------------------------------
# The fallback is the last extraction layer: it is asked only about fields the
# template and the rules engine could not find. Enabling it sends the text of a
# certificate - somebody's name, their parents' names, their identity number - to a
# third party. That is a decision for the office to take knowingly, so nothing below
# has any effect until LLM_ENABLED is true AND a key is supplied.
#
# Every value the model returns is looked for in the text that was sent. One that
# cannot be found is kept but flagged VALUE_UNVERIFIED, so an invented value reaches
# a reviewer with a warning rather than looking like any other reading.
LLM_ENABLED=false
LLM_PROVIDER=anthropic
# LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_BASE_URL=https://api.anthropic.com
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=45
# How much of a certificate's text is sent. Bounds what one request can disclose.
LLM_MAX_SOURCE_CHARS=12000
LLM_MAX_FIELDS_PER_REQUEST=40
# Send the page image as well as its text. A second, separate decision: an image
# discloses everything on the certificate, including what the pipeline never read.
LLM_ALLOW_VISION=false
# Answers are cached by a digest of the model, the text and the fields asked for.
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=604800
LLM_MAX_ATTEMPTS=2

# -----------------------------------------------------------------------------
# Rate limiting (sliding window in Redis, per user or per IP)
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Upload requests allowed per minute.
RATE_LIMIT_UPLOAD_PER_MINUTE=120
# Export requests allowed per minute. One export can read the whole register.
RATE_LIMIT_EXPORT_PER_MINUTE=10
# Searches allowed per minute. Cheap per query, and a way to read the register in
# aggregate, so this is generous enough that a busy counter never notices it.
RATE_LIMIT_SEARCH_PER_MINUTE=120
# CSV imports allowed per hour. Each one is potentially hours of worker time, so what
# this bounds is how much work one account can queue rather than how fast it can ask.
RATE_LIMIT_IMPORT_PER_HOUR=20
# Login attempts allowed per minute, keyed by client IP.
RATE_LIMIT_LOGIN_PER_MINUTE=10
# Catch-all ceiling for every other authenticated endpoint.
RATE_LIMIT_DEFAULT_PER_MINUTE=600

# -----------------------------------------------------------------------------
# Virus scanning (optional - skipped with a logged warning when unreachable)
# -----------------------------------------------------------------------------
CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Seed data - created on first boot. Local dev convenience only.
# -----------------------------------------------------------------------------
SEED_ENABLED=true
SEED_WORKSPACE_NAME=Demo Records Office
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345
SEED_OPERATOR_EMAIL=operator@example.com
SEED_OPERATOR_PASSWORD=operator12345
SEED_VIEWER_EMAIL=viewer@example.com
SEED_VIEWER_PASSWORD=viewer12345

# -----------------------------------------------------------------------------
# Frontend (Next.js). NEXT_PUBLIC_* values are inlined into the browser bundle.
# -----------------------------------------------------------------------------
# Base URL the BROWSER uses to reach the API. Must match the PUBLISHED API port,
# not the container port. Compose defaults it from API_PORT when left unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Base URL the Next.js server uses (container-to-container inside Compose).
API_INTERNAL_BASE_URL=http://api:8000
NEXT_PUBLIC_APP_NAME=CertExtract

# -----------------------------------------------------------------------------
# Gunicorn / Uvicorn / ports
# -----------------------------------------------------------------------------
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
API_PORT=8000
WEB_PORT=3000
